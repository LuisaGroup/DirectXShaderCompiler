// RUN: %dxc -T cs_6_0 -E main -spirv -fspv-constant-data -fspv-extension=SPV_KHR_constant_data %s

// A 256-entry lookup table emitted as VK_KHR_shader_constant_data /
// SPV_KHR_constant_data.
//
// SPV_KHR_constant_data adds OpConstantDataKHR (5147) and
// OpSpecConstantDataKHR (5148), which declare an array constant as one
// instruction whose operands are the *literal words* of the data, tightly
// packed, instead of an OpConstantComposite over one OpConstant per element.
// The instruction is guarded by the ConstantDataKHR capability and by
// OpExtension "SPV_KHR_constant_data"; on the Vulkan side the device must enable
// VK_KHR_shader_constant_data, whose feature struct carries one bit for the
// extension. DXC emits it only when -fspv-constant-data asks for it, so the
// default output of every shader is unchanged.
//
// Two problems it solves, both visible in this file:
//
// * Module size. Without the option the table below is 256 x OpConstant (4 words
//   each, 1024 words) plus an OpConstantComposite of 258 words. With the option
//   the table is one instruction of 2 + 256 words, and the per-element
//   OpConstant instructions disappear as soon as anything drops the unused
//   constants (the optimizer in the default pipeline does; -fcgl keeps them
//   because the front end created them before they turned out to be
//   unnecessary). For byte-sized data the saving is larger still: an 8-bit
//   element array needs one word per four elements.
//
// * Specialization. A pipeline that specializes the table only has to replace
//   the Data of one OpSpecConstantDataKHR (SPV_KHR_constant_data allows the
//   number of words to change, as long as the array Length is specialized too)
//   instead of rebuilding one OpConstant per table element. DXC does not emit
//   OpSpecConstantDataKHR yet: HLSL has no array specialization surface
//   ([[vk::constant_id]] only applies to scalar globals), so this file uses the
//   plain OpConstantDataKHR form.
//
// What the compiler checks: the result type is an OpTypeArray of an integer
// scalar type and carries no ArrayStride decoration (SPIRV-Tools enforces both),
// the data words match the array length and element width (also SPIRV-Tools),
// and the module validates for the target environment. What it cannot check:
// whether the device actually has the feature enabled.
//
// The table is a CRC-8 table (polynomial 0x07) - the shape of lookup table that
// real shaders use for hashing, dithering, or byte substitution.

// 256 entries: one OpConstantDataKHR of 256 words instead of 256 OpConstant
// instructions plus OpConstantComposite.
static const uint kCrc8Table[256] = {
  0x00, 0x07, 0x0e, 0x09, 0x1c, 0x1b, 0x12, 0x15,
  0x38, 0x3f, 0x36, 0x31, 0x24, 0x23, 0x2a, 0x2d,
  0x70, 0x77, 0x7e, 0x79, 0x6c, 0x6b, 0x62, 0x65,
  0x48, 0x4f, 0x46, 0x41, 0x54, 0x53, 0x5a, 0x5d,
  0xe0, 0xe7, 0xee, 0xe9, 0xfc, 0xfb, 0xf2, 0xf5,
  0xd8, 0xdf, 0xd6, 0xd1, 0xc4, 0xc3, 0xca, 0xcd,
  0x90, 0x97, 0x9e, 0x99, 0x8c, 0x8b, 0x82, 0x85,
  0xa8, 0xaf, 0xa6, 0xa1, 0xb4, 0xb3, 0xba, 0xbd,
  0xc7, 0xc0, 0xc9, 0xce, 0xdb, 0xdc, 0xd5, 0xd2,
  0xff, 0xf8, 0xf1, 0xf6, 0xe3, 0xe4, 0xed, 0xea,
  0xb7, 0xb0, 0xb9, 0xbe, 0xab, 0xac, 0xa5, 0xa2,
  0x8f, 0x88, 0x81, 0x86, 0x93, 0x94, 0x9d, 0x9a,
  0x27, 0x20, 0x29, 0x2e, 0x3b, 0x3c, 0x35, 0x32,
  0x1f, 0x18, 0x11, 0x16, 0x03, 0x04, 0x0d, 0x0a,
  0x57, 0x50, 0x59, 0x5e, 0x4b, 0x4c, 0x45, 0x42,
  0x6f, 0x68, 0x61, 0x66, 0x73, 0x74, 0x7d, 0x7a,
  0x89, 0x8e, 0x87, 0x80, 0x95, 0x92, 0x9b, 0x9c,
  0xb1, 0xb6, 0xbf, 0xb8, 0xad, 0xaa, 0xa3, 0xa4,
  0xf9, 0xfe, 0xf7, 0xf0, 0xe5, 0xe2, 0xeb, 0xec,
  0xc1, 0xc6, 0xcf, 0xc8, 0xdd, 0xda, 0xd3, 0xd4,
  0x69, 0x6e, 0x67, 0x60, 0x75, 0x72, 0x7b, 0x7c,
  0x51, 0x56, 0x5f, 0x58, 0x4d, 0x4a, 0x43, 0x44,
  0x19, 0x1e, 0x17, 0x10, 0x05, 0x02, 0x0b, 0x0c,
  0x21, 0x26, 0x2f, 0x28, 0x3d, 0x3a, 0x33, 0x34,
  0x4e, 0x49, 0x40, 0x47, 0x52, 0x55, 0x5c, 0x5b,
  0x76, 0x71, 0x78, 0x7f, 0x6a, 0x6d, 0x64, 0x63,
  0x3e, 0x39, 0x30, 0x37, 0x22, 0x25, 0x2c, 0x2b,
  0x06, 0x01, 0x08, 0x0f, 0x1a, 0x1d, 0x14, 0x13,
  0xae, 0xa9, 0xa0, 0xa7, 0xb2, 0xb5, 0xbc, 0xbb,
  0x96, 0x91, 0x98, 0x9f, 0x8a, 0x8d, 0x84, 0x83,
  0xde, 0xd9, 0xd0, 0xd7, 0xc2, 0xc5, 0xcc, 0xcb,
  0xe6, 0xe1, 0xe8, 0xef, 0xfa, 0xfd, 0xf4, 0xf3,
};

// 4 entries: below the default threshold of 8, so it keeps the composite form
// (see -fspv-constant-data=<threshold>).
static const uint kTag[4] = { 0x74616461, 0x00000001, 0x00000002, 0x00000003 };

RWStructuredBuffer<uint> outBuf;

// CRC-8 over the four bytes of one input word, one table lookup per byte.
uint crc8(uint v) {
  uint crc = 0xff;
  for (uint i = 0; i < 4; ++i) {
    crc = kCrc8Table[(crc ^ (v & 0xff)) & 0xff];
    v >>= 8;
  }
  return crc;
}

[numthreads(64, 1, 1)]
void main(uint3 tid : SV_DispatchThreadID) {
  outBuf[tid.x] = crc8(tid.x * 0x01010101u) ^ kTag[tid.x & 3];
}
